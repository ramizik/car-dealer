# Crusoe Managed Inference: Intelligence API key (Console > Intelligence Foundry > API Keys).
# Not the cloud CRUSOE_ACCESS_KEY / CRUSOE_SECRET_KEY pair. Wrap in single quotes if it contains $.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model tiers. Verify with: cd backend && python crusoe_check.py
CRUSOE_MODEL_SMART=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
CRUSOE_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
CRUSOE_MODEL_SIM=nvidia/Nemotron-3.5-Lightning-30B-A3B
CRUSOE_MODEL_VISION=nvidia/Nemotron-3-Nano-Omni-Reasoning-30B-A3B
# Requests per minute per model: 30 without a payment method on the Crusoe project, 600 with one
CRUSOE_RPM=30
# You.com Search / Contents / Research (backend/youcom.py also accepts YOU_API_KEY)
YDC_API_KEY=
# 1 = You.com from disk cache only (backend/data/cache), no network
DEMO_MODE=0
# 1 = templated simulator text (fast eval), 0 = Lightning rewrites it
SIM_FAST=0
# NVIDIA: speech (backend/voice.py: Parakeet ASR + Magpie TTS on NVCF) and memory embeddings (backend/vector_memory.py).
# Get the key: https://build.nvidia.com > sign in > profile > API Keys > Generate (starts with nvapi-). Empty = text only, local search.
# Verify: cd backend && python nvidia_check.py
NVIDIA_API_KEY=
NVIDIA_ASR_MODEL=parakeet-ctc-1_1b-asr
NVIDIA_TTS_MODEL=magpie-tts-multilingual
# Voice names: https://docs.nvidia.com/nim/speech/latest/tts/voices.html (format model.locale.speaker)
NVIDIA_TTS_VOICE=Magpie-Multilingual.EN-US.Aria
VECTOR_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# DigitalOcean droplet running NemoClaw + the backend (nemoclaw/SETUP.md). Ask the team for values.
# Access: send your SSH public key to whoever owns the droplet so they add it to ~/.ssh/authorized_keys.
DROPLET_IP=
DROPLET_PRIVATE_IP=
DROPLET_USER=root
