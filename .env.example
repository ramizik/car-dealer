# Crusoe Managed Inference: Intelligence API key (Console > Intelligence Foundry > API Keys).
# Not the cloud CRUSOE_ACCESS_KEY / CRUSOE_SECRET_KEY pair. Wrap in single quotes if it contains $.
CRUSOE_API_KEY=
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
# Model tiers. Verify with: cd backend && python crusoe_check.py
CRUSOE_MODEL_SMART=nvidia/Nemotron-3-Super-120B-A12B
CRUSOE_MODEL_FAST=nvidia/Nemotron-3-Nano-30B-A3B
CRUSOE_MODEL_SIM=nvidia/nemotron-3.5-lightning-30b-a3b
CRUSOE_MODEL_VISION=nvidia/Nemotron-3-Nano-Omni-Reasoning-30B-A3B
# Requests per minute per model: 30 without a payment method on the Crusoe project, 600 with one
CRUSOE_RPM=30
YOU_API_KEY=
